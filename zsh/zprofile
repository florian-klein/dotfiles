# Homebrew environment — static exports instead of `eval $(brew shellenv)`,
# which costs ~20ms (brew + path_helper spawns) on every login shell, and
# kitty opens every new window/tab as a login shell.
if [ -d /opt/homebrew/bin ]; then
  export HOMEBREW_PREFIX="/opt/homebrew"
  export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
  export HOMEBREW_REPOSITORY="/opt/homebrew"
  export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
  fpath[1,0]="/opt/homebrew/share/zsh/site-functions"
  export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
  [ -z "${MANPATH-}" ] || export MANPATH=":${MANPATH#:}"
elif [ -x /usr/local/bin/brew ]; then
  # Intel fallback: rare enough to keep the dynamic (slower) form
  eval "$(/usr/local/bin/brew shellenv)"
fi

# python.org framework Python, if installed
if [ -d /Library/Frameworks/Python.framework/Versions/3.10/bin ]; then
  PATH="/Library/Frameworks/Python.framework/Versions/3.10/bin:${PATH}"
  export PATH
fi

export PATH="$HOME/.local/share/solana/install/active_release/bin:$PATH"

export PATH="$PATH:/usr/local/bin"

# OrbStack command-line tools, if installed
source ~/.orbstack/shell/init.zsh 2>/dev/null || :
