# ===== Functions =====
# Git quick push
gp() {
  git add . && git commit -m "$1" && git push
}

# Extract any archive type
extract() {
  if [[ -f "$1" ]]; then
    case "$1" in
      *.tar.bz2)   tar xjf "$1"     ;;
      *.tar.gz)    tar xzf "$1"     ;;
      *.tar.xz)    tar xJf "$1"     ;;
      *.bz2)       bunzip2 "$1"     ;;
      *.rar)       unrar x "$1"     ;;
      *.gz)        gunzip "$1"      ;;
      *.tar)       tar xf "$1"      ;;
      *.tbz2)      tar xjf "$1"     ;;
      *.tgz)       tar xzf "$1"     ;;
      *.zip)       unzip "$1"       ;;
      *.Z)         uncompress "$1"  ;;
      *.7z)        7z x "$1"        ;;
      *)           echo "'$1' cannot be extracted via extract()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

# Make directory and cd into it
mkcd() {
  mkdir -p "$1" && cd "$1"
}

# Quick find file
ff() {
  find . -type f -iname "*$1*"
}

# yazi: file manager that cd's into the directory you quit from
y() {
  local tmp cwd
  tmp="$(mktemp -t yazi-cwd.XXXXXX)"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

# ===== Kitty Notifications =====
# Usage: knof <command>   — run command, notify when done
# Usage: <command>; knof  — notify after previous command
knof() {
  if [[ $# -eq 0 ]]; then
    local code=$?
    if [[ $code -eq 0 ]]; then
      kitten notify "Done" "Command finished successfully"
    else
      kitten notify --icon warn "Failed" "Command exited with code $code"
    fi
    return $code
  fi
  "$@"
  local code=$?
  local cmd="${1##*/}"
  if [[ $code -eq 0 ]]; then
    kitten notify "Done" "$cmd finished successfully"
  else
    kitten notify --icon warn "Failed" "$cmd exited with code $code"
  fi
  return $code
}

