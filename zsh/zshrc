# ===== Completion =====
# uv/uvx completions are cached in ~/.zsh_completions (regenerate with:
#   uv generate-shell-completion zsh > ~/.zsh_completions/_uv
#   uvx --generate-shell-completion zsh > ~/.zsh_completions/_uvx)
fpath=(~/.zsh_completions $fpath)

# compinit with a daily cache: full (secure-dir-check skipped, was
# ZSH_DISABLE_COMPFIX under oh-my-zsh) once per day, -C otherwise.
# Staleness check uses a zsh glob qualifier — no `find` process spawn.
autoload -Uz compinit
_zcd=(~/.zcompdump(N.mh+24))
if [[ -n $_zcd || ! -f ~/.zcompdump ]]; then
  compinit -u
  { rm -f ~/.zcompdump.zwc; zcompile ~/.zcompdump } &!
else
  compinit -C
fi
unset _zcd

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'  # case-insensitive
zstyle ':completion:*' menu no                             # fzf-tab draws the menu
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

# ===== Plugins (replaces oh-my-zsh) =====
# HOMEBREW_PREFIX is set by brew shellenv in .zprofile (Apple Silicon or Intel)
_bp=${HOMEBREW_PREFIX:-/opt/homebrew}
[[ -r $_bp/share/powerlevel10k/powerlevel10k.zsh-theme ]] && source $_bp/share/powerlevel10k/powerlevel10k.zsh-theme
[[ -r ~/.zsh/plugins/fzf-tab/fzf-tab.plugin.zsh ]] && source ~/.zsh/plugins/fzf-tab/fzf-tab.plugin.zsh
[[ -r $_bp/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && source $_bp/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -r $_bp/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh ]] && source $_bp/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh
unset _bp

# fzf-tab previews
