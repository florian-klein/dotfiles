# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# This file is the eager, prompt-critical path only (<10ms). Everything slow
# (p10k theme, compinit, plugins, atuin/fzf/zoxide) lives in ~/.zshrc.lazy,
# loaded by zsh-defer right after the first prompt renders.

# ===== Shell Options =====
bindkey -e                       # Emacs keymap (explicit, independent of $EDITOR)
setopt AUTO_CD                   # Type a directory name to cd into it
setopt INTERACTIVE_COMMENTS      # Allow # comments on the command line

# ===== History Configuration =====
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY          # Write timestamp to history
setopt HIST_EXPIRE_DUPS_FIRST    # Expire duplicates first
setopt HIST_IGNORE_DUPS          # Ignore consecutive duplicates
setopt HIST_IGNORE_SPACE         # Ignore commands starting with space
setopt HIST_VERIFY               # Show command before executing from history
setopt SHARE_HISTORY             # Share history between sessions
setopt INC_APPEND_HISTORY        # Add commands immediately

# ===== Environment =====
export PKG_CONFIG_PATH=/opt/homebrew/opt/curl/lib/pkgconfig
export RUST_MIN_STACK=16777216

export PATH=/Library/TeX/texbin:$PATH
export PATH=$HOME/.cargo/bin:$PATH
export PATH=$HOME/.local/bin:$PATH
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
export PATH="/opt/homebrew/opt/llvm/bin:$PATH"
export JAVA_HOME="/opt/homebrew/opt/openjdk@17"
export PATH="/opt/homebrew/opt/openjdk@17/bin:$PATH"
export PATH="/opt/homebrew/opt/bison/bin:$PATH"
export PATH="/opt/homebrew/opt/flex/bin:$PATH"
export PATH="/opt/homebrew/opt/curl/bin:$PATH"
export PATH="/usr/local/texlive/texmf-local:$PATH"
export PATH="/opt/homebrew/opt/openjdk/bin:$PATH"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# uv/uvx completions are cached in ~/.zsh_completions (regenerate with:
#   uv generate-shell-completion zsh > ~/.zsh_completions/_uv
#   uvx --generate-shell-completion zsh > ~/.zsh_completions/_uvx)
fpath=(~/.zsh_completions $fpath)

# fzf colors: Gruvbox accents; fg/bg omitted to inherit white-on-black.
# Eager because any fzf invocation (scripts included) should pick it up.
export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border \
--color=bg+:#3c3836,spinner:#fb4934,hl:#fe8019 \
--color=header:#fe8019,info:#fabd2f,pointer:#fb4934 \
--color=marker:#fb4934,fg+:#ffffff,prompt:#fabd2f,hl+:#fe8019 \
--color=border:#504945,selected-bg:#504945"

# >>> conda initialize (lazy-loaded) >>>
# Conda is only initialized when first called, saving ~300ms on every shell startup
conda() {
  unfunction conda
  __conda_setup="$("$HOME/miniconda3/bin/conda" 'shell.zsh' 'hook' 2>/dev/null)"
  if [ $? -eq 0 ]; then
    eval "$__conda_setup"
  else
    if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
      . "$HOME/miniconda3/etc/profile.d/conda.sh"
    else
      export PATH="$HOME/miniconda3/bin:$PATH"
    fi
  fi
  unset __conda_setup
  conda "$@"
}
# Also lazy-load common conda subcommands so they trigger init
for _cmd in activate deactivate mamba; do
  eval "${_cmd}() { unfunction ${_cmd} 2>/dev/null; conda ${_cmd} \"\$@\"; }"
done
unset _cmd
# <<< conda initialize <<<

