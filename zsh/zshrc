zstyle ':fzf-tab:complete:(\\|*/|)z:*' fzf-preview 'eza --tree --icons --level=2 --color=always $realpath'

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# >>> conda initialize (lazy-loaded) >>>
# Conda is only initialized when first called, saving ~300ms on every shell startup
conda() {
  unfunction conda
  __conda_setup="$("$HOME/miniconda3/bin/conda" 'shell.zsh' 'hook' 2>/dev/null)"
  if [ $? -eq 0 ]; then
    eval "$__conda_setup"
  else
    if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
      . "$HOME/miniconda3/etc/profile.d/conda.sh"
    else
      export PATH="$HOME/miniconda3/bin:$PATH"
    fi
  fi
  unset __conda_setup
  conda "$@"
}
# Also lazy-load common conda subcommands so they trigger init
for _cmd in activate deactivate mamba; do
  eval "${_cmd}() { unfunction ${_cmd} 2>/dev/null; conda ${_cmd} \"\$@\"; }"
done
unset _cmd
# <<< conda initialize <<<

