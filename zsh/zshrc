# ===== Functions =====
# Git quick push
gp() {
  git add . && git commit -m "$1" && git push
}

# Extract any archive type
extract() {
  if [[ -f "$1" ]]; then
    case "$1" in
      *.tar.bz2)   tar xjf "$1"     ;;
      *.tar.gz)    tar xzf "$1"     ;;
      *.tar.xz)    tar xJf "$1"     ;;
      *.bz2)       bunzip2 "$1"     ;;
      *.rar)       unrar x "$1"     ;;
      *.gz)        gunzip "$1"      ;;
      *.tar)       tar xf "$1"      ;;
      *.tbz2)      tar xjf "$1"     ;;
      *.tgz)       tar xzf "$1"     ;;
      *.zip)       unzip "$1"       ;;
      *.Z)         uncompress "$1"  ;;
      *.7z)        7z x "$1"        ;;
      *)           echo "'$1' cannot be extracted via extract()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

# Make directory and cd into it
mkcd() {
  mkdir -p "$1" && cd "$1"
}

# Quick find file
ff() {
  find . -type f -iname "*$1*"
}

# yazi: file manager that cd's into the directory you quit from
y() {
  local tmp cwd
  tmp="$(mktemp -t yazi-cwd.XXXXXX)"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

# ===== Kitty Notifications =====
# Usage: knof <command>   — run command, notify when done
# Usage: <command>; knof  — notify after previous command
knof() {
  if [[ $# -eq 0 ]]; then
    local code=$?
    if [[ $code -eq 0 ]]; then
      kitten notify "Done" "Command finished successfully"
    else
      kitten notify --icon warn "Failed" "Command exited with code $code"
    fi
    return $code
  fi
  "$@"
  local code=$?
  local cmd="${1##*/}"
  if [[ $code -eq 0 ]]; then
    kitten notify "Done" "$cmd finished successfully"
  else
    kitten notify --icon warn "Failed" "$cmd exited with code $code"
  fi
  return $code
}

# ===== Keybindings =====
bindkey '^[[A' history-search-backward  # Up arrow: search history backward
bindkey '^[[B' history-search-forward   # Down arrow: search history forward
bindkey '^[[1;5C' forward-word          # Ctrl+Right: move word forward
bindkey '^[[1;5D' backward-word         # Ctrl+Left: move word backward
bindkey '^[[H' beginning-of-line        # Home: beginning of line
bindkey '^[[F' end-of-line              # End: end of line

# ===== PATH Deduplication =====
# Remove duplicate entries from PATH (keeps first occurrence)
typeset -U PATH path

# ===== Machine-local config (untracked: SSH host aliases, secrets, etc.) =====
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# ===== Prompt (powerlevel10k) =====
# Eager on purpose: deferring the theme makes the first prompt flash zsh's
# default PS1 before p10k loads (verified frame-by-frame in kitty). ~12ms.
_bp=${HOMEBREW_PREFIX:-/opt/homebrew}
[[ -r $_bp/share/powerlevel10k/powerlevel10k.zsh-theme ]] && source $_bp/share/powerlevel10k/powerlevel10k.zsh-theme
unset _bp
# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ===== Deferred initialization =====
# ~/.zshrc.lazy queues compinit, fzf-tab, autosuggestions, syntax
# highlighting and fzf/atuin/zoxide via zsh-defer — they load right after
# the first prompt, yielding to your keystrokes between slices.
if [[ -r ~/.zsh/plugins/zsh-defer/zsh-defer.plugin.zsh && -r ~/.zshrc.lazy ]]; then
  source ~/.zsh/plugins/zsh-defer/zsh-defer.plugin.zsh
  source ~/.zshrc.lazy
fi
