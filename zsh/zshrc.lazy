# Deferred initialization — sourced at the end of .zshrc. Each unit below is
# queued via zsh-defer and runs after the first prompt renders; zsh-defer
# yields to pending keystrokes between units, so a command typed immediately
# only ever waits for one slice, not the whole chain.

_bp=${HOMEBREW_PREFIX:-/opt/homebrew}

# ===== Completion =====
# compinit with a daily cache: full (secure-dir-check skipped) once per day,
# -C otherwise. Staleness check via zsh glob qualifier — no process spawn.
_lazy_compinit() {
  autoload -Uz compinit
  local -a zcd
  zcd=(~/.zcompdump(N.mh+24))
  if [[ -n $zcd || ! -f ~/.zcompdump ]]; then
    compinit -u
    { rm -f ~/.zcompdump.zwc; zcompile ~/.zcompdump } &!
  else
    compinit -C
  fi
}
zsh-defer _lazy_compinit

# Completion styles (cheap, no spawns — set immediately)
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'  # case-insensitive
zstyle ':completion:*' menu no                             # fzf-tab draws the menu
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

# fzf-tab previews
zstyle ':fzf-tab:*' use-fzf-default-opts yes
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza --tree --icons --level=2 --color=always $realpath'
zstyle ':fzf-tab:complete:(\\|*/|)z:*' fzf-preview 'eza --tree --icons --level=2 --color=always $realpath'

# ===== Plugins (one defer slice each) =====
# Autosuggestions: skip the per-prompt widget rebind scan and don't search
# suggestions for very long buffers — lower command/input lag
typeset -g ZSH_AUTOSUGGEST_MANUAL_REBIND=1
typeset -g ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20

zsh-defer source ~/.zsh/plugins/fzf-tab/fzf-tab.plugin.zsh
zsh-defer source $_bp/share/zsh-autosuggestions/zsh-autosuggestions.zsh
zsh-defer source $_bp/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh

# ===== Tools =====
# Zoxide (regenerate cache: zoxide init zsh > ~/.zsh_completions/zoxide.zsh)
zsh-defer source ~/.zsh_completions/zoxide.zsh

# fzf Ctrl+T / Alt+C (regenerate cache: fzf --zsh > ~/.zsh_completions/fzf.zsh)
export FZF_ALT_C_OPTS="--preview 'eza --tree --icons --level=2 {}'"
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --line-range :50 {}'"
zsh-defer source ~/.zsh_completions/fzf.zsh

# Atuin Ctrl+R — after fzf so atuin owns the binding; up arrow stays zsh's
# history-search-backward (regenerate after upgrades:
# atuin init zsh --disable-up-arrow --disable-ai > ~/.zsh_completions/atuin.zsh)
zsh-defer source ~/.zsh_completions/atuin.zsh

# ===== Misc environment =====
_lazy_misc() {
  # OrbStack command-line tools, if installed
  source ~/.orbstack/shell/init.zsh 2>/dev/null || :
  # OCaml
  [[ ! -r $HOME/.opam/opam-init/init.zsh ]] || source $HOME/.opam/opam-init/init.zsh > /dev/null 2>&1
  # bun completions
  [ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
}
zsh-defer _lazy_misc

unset _bp
